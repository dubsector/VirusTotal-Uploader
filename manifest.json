{
  "manifest_version": 3,
  "name": "VirusTotal Uploader",
  "version": "69.0.0",
  "description": "Upload files to VirusTotal from Chrome and open the analysis report when the scan is ready.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "upload.html",
    "default_title": "VirusTotal Uploader"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.virustotal.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.virustotal.com/gui/*"],
      "js": ["vt-content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "vt_frame",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
